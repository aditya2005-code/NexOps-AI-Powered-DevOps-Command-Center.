# Application Configuration
APP_NAME=NexOps
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database (Neon PostgreSQL / SQLAlchemy 2.0)
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# JWT Security - for future phases
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Providers (LangChain / LangGraph Multi-Agent Runtime)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Switch Integration (Agent Bridge)
SWITCH_ENABLED=false
SWITCH_CORE_URL=http://localhost:8080
SWITCH_API_KEY=sk_sample_placeholder
SWITCH_AGENT_ID=nexops-incident-agent
SWITCH_RECONNECT_INITIAL_DELAY=2.0
SWITCH_RECONNECT_MAX_DELAY=60.0
SWITCH_CONNECTION_TIMEOUT=15.0
SWITCH_ROOM_PROJECT_MAPPING={"ops-general": "Core API"}
